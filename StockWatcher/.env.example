# StockWatcher configuration.  Copy to .env and fill in.
#   cp .env.example .env
# Everything here is optional for a local `--dry-run`.

# ---------------------------------------------------------------- WhatsApp
# See docs/whatsapp-template.md.  Required only when not using --dry-run.
ACS_CONNECTION_STRING=
ACS_CHANNEL_REGISTRATION_ID=
# Comma-separated E.164 numbers, e.g. +573001234567
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=stockwatcher_restock
WHATSAPP_TEMPLATE_LANG=es
# `template` (default, works any time) or `text` (free-form; only valid inside
# the 24h window opened by an inbound message from the recipient).
WHATSAPP_MODE=template

# ------------------------------------------------------------- State store
# Backend is chosen with --state-backend {sqlite,azure_table,none}.
# sqlite (default, local dev):
STOCKWATCHER_STATE_BACKEND=sqlite
STOCKWATCHER_STATE_PATH=data/stockwatcher.db
# azure_table (production).  Either a connection string...
AZURE_STORAGE_CONNECTION_STRING=
# ...or an account URL plus managed identity (preferred in Container Apps):
AZURE_STORAGE_ACCOUNT_URL=
AZURE_TABLE_NAME=stockwatcher

# --------------------------------------------------------------- Discovery
# Store auto-discovery web-searches each watch's terms to find new retailers.
# Pick ONE backend; with no key configured discovery degrades to a no-op and
# the normal availability pass is unaffected.
#   brave   -> https://brave.com/search/api/       (free tier available)
#   bing    -> Azure AI Search / Bing Search v7
#   serpapi -> https://serpapi.com/
STOCKWATCHER_SEARCH_BACKEND=brave
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
SERPAPI_API_KEY=

# ------------------------------------------------------- Browser providers
# Stores using the `nike`/`playwright` providers ship disabled, because they
# need a chromium that a plain `pip install` does not provide.  Set this to 1
# once you have run `playwright install chromium`.  The Docker image sets it.
STOCKWATCHER_ENABLE_BROWSER_STORES=0
