# PortfolioWatcher configuration. Copy to .env and fill in.
#   cp .env.example .env
# Everything here is optional for a local `--dry-run` (console notifier,
# no Azure OpenAI calls — the CLI falls back to a no-op summary).

# --------------------------------------------------------------- Azure OpenAI
# Azure AI Foundry / Azure OpenAI resource used for the two-tier LLM pipeline.
# Tier 1 "triage" uses a cheap model to discard noise from raw news items.
# Tier 2 "analysis" uses a stronger model to classify surviving items into
# riesgo | oportunidad | ruido, assign severity and write a short thesis.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names as created in infra/main.tf.
AZURE_OPENAI_TRIAGE_DEPLOYMENT=portfoliowatcher-triage
AZURE_OPENAI_ANALYSIS_DEPLOYMENT=portfoliowatcher-analysis

# ---------------------------------------------------------------- WhatsApp
# See StockWatcher's docs/whatsapp-template.md for the ACS setup pattern this
# reuses. Required only when using the `whatsapp` notifier (not --dry-run).
ACS_CONNECTION_STRING=
ACS_CHANNEL_REGISTRATION_ID=
# Comma-separated E.164 numbers, e.g. +573001234567
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=portfoliowatcher_alert
WHATSAPP_TEMPLATE_LANG=es
# `template` (default, works any time) or `text` (free-form; only valid inside
# the 24h window opened by an inbound message from the recipient).
WHATSAPP_MODE=template

# ------------------------------------------------------------------- Email
# Segundo canal sobre el MISMO recurso de ACS (Email es una capacidad enlazada
# aparte del canal WhatsApp, así que reutiliza ACS_CONNECTION_STRING de arriba).
# No requiere aprobación de plantillas de Meta: con un dominio administrado de
# Azure (*.azurecomm.net) queda operativo en minutos. Mismas claves que usa
# StockWatcher para que ambos repos sean consistentes.
ACS_EMAIL_SENDER=
# Comma-separated, e.g. tu-correo@example.com
EMAIL_TO=
EMAIL_SUBJECT=PortfolioWatcher: informe de portafolio

# --------------------------------------------------------------- Telegram
# Canal alternativo más simple (Telegram bot API sobre HTTP, sin SDK).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which notifier(s) to use for daily/weekly sends, comma-separated.
# Conocidos: console, whatsapp, email, telegram.
PORTFOLIOWATCHER_NOTIFIERS=whatsapp
# El destino también puede pasarse por invocación con `--notify-to`, que
# tiene precedencia sobre WHATSAPP_TO / EMAIL_TO (ver notifier.py).

# ------------------------------------------------------------- State store
PORTFOLIOWATCHER_STATE_PATH=data/portfoliowatcher.db

# --------------------------------------------------------------- SEC EDGAR
# EDGAR requires a descriptive User-Agent identifying you, per SEC fair-access
# policy: https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# ------------------------------------------------------------------ Config
PORTFOLIOWATCHER_CONFIG_PATH=config/portfolio.yaml
