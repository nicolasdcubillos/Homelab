# Copy to terraform.tfvars and fill in your own values.
#   cp terraform.tfvars.example terraform.tfvars

# Generic name -- this VM/infra is meant to host more than just
# PortfolioWatcher over time, so keep it neutral (e.g. "homelab",
# "personal-infra", "nico-vm"). PortfolioWatcher's own code/config lives in
# /opt/services/portfoliowatcher/ on the VM regardless of this value.
project_name = "homelab"

location = "eastus"

admin_username = "azureuser"

# Contents of e.g. ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Your current public IP in CIDR form, e.g. "203.0.113.10/32".
# Update this if your IP changes; avoid leaving SSH open to "*".
allowed_ssh_source_address = "203.0.113.10/32"

vm_size = "Standard_B2s"

openai_sku_name               = "S0"
openai_triage_model           = "gpt-5-6-luna"
openai_triage_model_version   = "1"
openai_analysis_model         = "gpt-5-6-sol"
openai_analysis_model_version = "1"
openai_deployment_capacity    = 10

create_communication_service = true
acs_data_location            = "United States"

tags = {
  managed_by = "terraform"
  purpose    = "homelab"
}
