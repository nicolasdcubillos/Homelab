# HomelabDashboard - Caddyfile de referencia (EJEMPLO, sin credenciales reales)
#
# Copia este archivo a /etc/caddy/Caddyfile (o el que use tu instalación) y
# reemplaza el dominio y las credenciales por las reales. Genera el hash de
# la contraseña con: caddy hash-password
#
# El dashboard debe seguir escuchando solo en 127.0.0.1 (DASHBOARD_HOST), y
# es Caddy quien expone el puerto público con TLS + Basic Auth.

dashboard.tu-dominio.example {
    basic_auth {
        # usuario  hash_bcrypt_generado_con_"caddy hash-password"
        admin JDJhJDE0JEV4YW1wbGVIYXNoTm9SZWFsQ3JlZGVudGlhbA
    }

    reverse_proxy localhost:8000
}
