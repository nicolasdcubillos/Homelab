# /etc/homelab/market-regime.env: propietario root, permisos 0600.
# Solo configuracion del modulo; nunca copiar secretos de otros servicios.
# Activar el motor no habilita las entregas ni concede licencias.
DASHBOARD_REGIME_ENABLED=false
DASHBOARD_REGIME_DELIVERIES_ENABLED=false
DASHBOARD_REGIME_BLS_KEY=
DASHBOARD_REGIME_BEA_KEY=
DASHBOARD_REGIME_FRED_KEY=
DASHBOARD_REGIME_ACS_CONNECTION_STRING=
DASHBOARD_REGIME_ACS_EMAIL_SENDER=
DASHBOARD_REGIME_ACS_CHANNEL_ID=
DASHBOARD_REGIME_WHATSAPP_TEMPLATE_NAME=
DASHBOARD_REGIME_WHATSAPP_TEMPLATE_LANGUAGE=es
DASHBOARD_REGIME_WHATSAPP_TEMPLATE_APPROVED=false
DASHBOARD_REGIME_PUBLIC_BASE_URL=
DASHBOARD_REGIME_DISK_MIN_FREE_MB=1024
# Timeout ACS en segundos; los conectores oficiales tienen limites HTTP propios.
DASHBOARD_REGIME_TIMEOUT=20
