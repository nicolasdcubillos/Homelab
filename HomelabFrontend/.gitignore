# Registro real de apps administradas - NUNCA se versiona (contiene rutas
# específicas de la VM de producción; copia apps.yaml.example para empezar).
apps.yaml

# Logs de ejecuciones de jobs.
logs/
logs/**

# Historial de jobs (SQLite).
dashboard.db
dashboard.db-journal
dashboard.db-wal
dashboard.db-shm

# Datos por usuario: base multiusuario, workspaces generados y estado de cada
# watcher. Todo esto se genera en tiempo de ejecución; nada se versiona.
data/
!src/homelab_dashboard/market_regime/data/
!src/homelab_dashboard/market_regime/data/nyse-calendar.json

# Frontend: dependencias y build. El build se genera con `npm run build` (ver
# docs/deployment.md); no se versiona el artefacto ni node_modules.
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/*.tsbuildinfo

# Entornos virtuales.
.venv/
venv/

# Python.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Backups de configuración con timestamp (ej. portfolio.yaml.bak.20260903-153000).
*.bak.*

# Editores / SO.
.DS_Store
.idea/
.vscode/
