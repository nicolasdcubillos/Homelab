# Copia este archivo a `.env` para desarrollo local, o llévalo al
# `EnvironmentFile=` de la unidad de systemd en la VM.
#
# TradingLab NO carga este archivo por su cuenta: no quiere depender de
# python-dotenv y, sobre todo, no quiere que un `.env` olvidado en un directorio
# cualquiera cambie el comportamiento del proceso en producción. Cárgalo tú:
#
#     set -a && source .env && set +a && tradinglab correr

# --- Rutas ------------------------------------------------------------------

# Base del dashboard, de donde se lee la configuración compartida. Se abre en
# solo lectura; TradingLab nunca escribe aquí.
TRADINGLAB_DASHBOARD_DB=data/dashboard.db

# Base propia, que el dashboard lee en solo lectura. Tiene que coincidir con
# `DASHBOARD_TRADINGLAB_DB` del dashboard o cada uno mirará un archivo distinto
# y el panel dirá que el motor está caído.
TRADINGLAB_DB=data/tradinglab.db

# --- Alpaca Paper -----------------------------------------------------------

# Se sacan de https://app.alpaca.markets/paper/dashboard/overview → API Keys.
# Son de la cuenta *paper*: no dan acceso a dinero real.
#
# Van aquí y no en la configuración del dashboard porque esa configuración la
# puede editar —y leer— cualquier usuario autorizado desde el celular.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Lumibot ----------------------------------------------------------------

# Importar Lumibot dispara un escaneo recursivo del sistema de archivos
# buscando un `.env`. TradingLab ya lo desactiva por su cuenta; se deja escrito
# por si alguien lo importa desde otro sitio.
LUMIBOT_DISABLE_DOTENV=1
